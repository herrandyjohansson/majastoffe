# Gmail SMTP + Nodemailer (works on Vercel if you await sendMail — no callbacks)
# Copy into .env.local and set the same keys in Vercel → Project → Settings → Environment Variables.
# Ref: https://stackoverflow.com/questions/65631481/nodemailer-in-vercel-not-sending-email-in-production

# Gmail account that sends mail (use a Google "App password", not your normal password):
# https://myaccount.google.com/apppasswords — requires 2-Step Verification on the account.
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=

# Inbox that receives each OSA (often the same as GMAIL_USER).
OSA_NOTIFY_EMAIL=you@gmail.com

# Optional: CC (one address or comma-separated, e.g. partner@example.com,other@gmail.com)
# OSA_CC_EMAIL=loekandy@gmail.com
